<script>
  import { enhancePublicSettings, type PublicSettingsView } from "../lib/publicSettings";

  const view: PublicSettingsView = {
    setText(key, value) {
      for (const node of document.querySelectorAll<HTMLElement>(`[data-public-setting="${key}"]`)) {
        node.textContent = value;
      }
    },
    setMaximumPets(maximum) {
      for (const select of document.querySelectorAll<HTMLSelectElement>("[data-max-pets-select]")) {
        const selected = Number(select.value);
        const options = Array.from({ length: maximum + 1 }, (_, count) => {
          const option = document.createElement("option");
          option.value = String(count);
          option.textContent = count === 0 ? "No pets" : `${count} ${count === 1 ? "pet" : "pets"}`;
          return option;
        });
        select.replaceChildren(...options);
        select.value = selected <= maximum ? String(selected) : "0";
        select.dataset.maximumPets = String(maximum);
      }
    },
  };

  const controller = new AbortController();
  const timeout = window.setTimeout(() => controller.abort(), 2500);

  try {
    await enhancePublicSettings(
      () =>
        fetch("/.netlify/functions/public-settings", {
          headers: { Accept: "application/json" },
          signal: controller.signal,
        }),
      view,
    );
  } finally {
    window.clearTimeout(timeout);
  }
</script>
