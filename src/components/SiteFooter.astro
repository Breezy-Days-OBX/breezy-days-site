---
import { property } from "../content/property";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="wordmark wordmark-light" href="/#hero">Breezy Days <span>OBX</span></a>
      <p class="footer-note">
        A family beach home in {property.identity.location}.
      </p>
    </div>
    <div>
      <p class="footer-title">Explore</p>
      <a href="/#fit">Is it a fit?</a>
      <a href="/#home">The Home</a>
      <a href="/#reviews">Guest Reviews</a>
      <a href="/#faq">FAQs</a>
      <a href="/rental-information">Rental information</a>
      <a href="/privacy">Privacy</a>
    </div>
    <div>
      <p class="footer-title">Questions?</p>
      <a href={`mailto:${property.identity.email}`}>{property.identity.email}</a>
      <p class="footer-note">Availability and total price are confirmed by the owner.</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Breezy Days OBX</span>
    <span>Direct booking, with a human on the other side.</span>
  </div>
</footer>
