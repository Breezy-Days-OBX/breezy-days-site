---
import { property } from "../content/property";
import { siteContent } from "../content/site";
---

<form
  class="availability-form"
  name="availability-request"
  method="POST"
  action="/thanks"
  data-netlify="true"
  netlify-honeypot="company-website"
  novalidate
  aria-busy="false"
  data-state="idle"
>
  <input type="hidden" name="form-name" value="availability-request" />
  <p class="honeypot" hidden>
    <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="form-intro">
    <p class="eyebrow">Start with the week</p>
    <h2>Tell us who’s coming.</h2>
    <p>
      Michelle and Danny review every request against the synced Airbnb and Vrbo calendars,
      guest fit, and date-specific pricing.
    </p>
  </div>

  <div class="form-error-summary" data-form-error-summary role="alert" tabindex="-1" hidden>
    <h3>Please check the highlighted details.</h3>
    <ul></ul>
  </div>

  <fieldset class="form-group form-group-stay">
    <legend>Your stay</legend>
    <div class="form-fields form-fields-stay">
      <div class="form-field">
        <label for="arrival">Arrival</label>
        <input id="arrival" name="arrival" type="date" aria-describedby="arrival-hint arrival-error" required />
        <span class="field-hint" id="arrival-hint">Check-in is {property.arrival.checkIn.toLowerCase()}.</span>
        <span class="field-error" id="arrival-error" data-field-error="arrival" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="departure">Departure</label>
        <input id="departure" name="departure" type="date" aria-describedby="departure-hint departure-error" required />
        <span class="field-hint" id="departure-hint">Checkout is {property.arrival.checkout.toLowerCase()}.</span>
        <span class="field-error" id="departure-error" data-field-error="departure" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="guests">Overnight guests</label>
        <input
          id="guests"
          name="guests"
          type="number"
          min="1"
          max={property.fit.maximumOvernightGuests}
          inputmode="numeric"
          aria-describedby="guests-hint guests-error"
          required
        />
        <span class="field-hint" id="guests-hint">Up to {property.fit.maximumOvernightGuests} overnight guests.</span>
        <span class="field-error" id="guests-error" data-field-error="guests" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="pets">Pets</label>
        <select id="pets" name="pets" aria-describedby="pets-hint pets-error" required>
          <option value="0">No pets</option>
          {Array.from({ length: property.pets.maximum }, (_, index) => index + 1).map((count) => (
            <option value={count}>{count} {count === 1 ? "pet" : "pets"}</option>
          ))}
        </select>
        <span class="field-hint" id="pets-hint">Up to <span data-public-setting="maxPets">{property.pets.maximum}</span> pets.</span>
        <span class="field-error" id="pets-error" data-field-error="pets" aria-live="polite"></span>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-group form-group-contact">
    <legend>How the owner can reply</legend>
    <div class="form-fields form-fields-contact">
      <div class="form-field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" aria-describedby="name-error" required />
        <span class="field-error" id="name-error" data-field-error="name" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" aria-describedby="email-error" required />
        <span class="field-error" id="email-error" data-field-error="email" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" minlength="7" maxlength="20" aria-describedby="phone-hint phone-error" required />
        <span class="field-hint" id="phone-hint">Used only if the owner needs to clarify the request.</span>
        <span class="field-error" id="phone-error" data-field-error="phone" aria-live="polite"></span>
      </div>

      <div class="form-field form-field-message">
        <label for="message">Anything the owner should know? <span>(optional)</span></label>
        <textarea id="message" name="message" rows="4" maxlength="500" aria-describedby="message-hint message-error"></textarea>
        <span class="field-hint" id="message-hint">Accessibility needs or a brief question are helpful here. Please do not include payment information.</span>
        <span class="field-error" id="message-error" data-field-error="message" aria-live="polite"></span>
      </div>
    </div>
  </fieldset>

  <div class="form-confirmations">
    <div class="checkbox-field">
      <input id="acknowledges-request" name="acknowledgesRequestNotReservation" type="checkbox" value="true" aria-describedby="acknowledgesRequestNotReservation-error" required />
      <label for="acknowledges-request">
        I understand this request is not a reservation or a guaranteed price. The owner must confirm availability, total price, the agreement, and payment steps.
      </label>
      <span class="field-error" id="acknowledgesRequestNotReservation-error" data-field-error="acknowledgesRequestNotReservation" aria-live="polite"></span>
    </div>
    <div class="checkbox-field">
      <input id="acknowledges-privacy" name="acknowledgesPrivacy" type="checkbox" value="true" aria-describedby="acknowledgesPrivacy-error" required />
      <label for="acknowledges-privacy">
        I agree that Breezy Days may use these details to review and reply to this request, as described in the <a href="/privacy">privacy notice</a>.
      </label>
      <span class="field-error" id="acknowledgesPrivacy-error" data-field-error="acknowledgesPrivacy" aria-live="polite"></span>
    </div>
  </div>

  <div class="form-action">
    <button class="button form-submit" type="submit">
      <span data-submit-label>{siteContent.primaryAction.label}</span>
      <span class="form-pending-label" aria-hidden="true">Sending request…</span>
    </button>
    <p>
      No payment is collected here. Your request goes to the owners for a personal review.
    </p>
  </div>
</form>

<script>
  import { addDays, toLocalIsoDate } from "../lib/dateRules";
  import { trackPublicEvent } from "../lib/analytics";
  import { validateInquiry } from "../lib/inquiry";

  const errorMessages: Record<string, string> = {
    "arrival.invalid_date": "Enter a valid arrival date.",
    "arrival.not_future": "Choose an arrival date after today.",
    "departure.invalid_date": "Enter a valid departure date.",
    "departure.not_after_arrival": "Choose a departure date after arrival.",
    "guests.invalid_type": "Enter the number of overnight guests.",
    "guests.out_of_range": "Enter a guest count within the home’s overnight capacity.",
    "pets.invalid_type": "Select the number of pets.",
    "pets.out_of_range": "Select a pet count within the current pet limit.",
    "name.invalid_type": "Enter your name.",
    "name.invalid_length": "Enter a name between 2 and 80 characters.",
    "email.invalid_type": "Enter your email address.",
    "email.invalid_email": "Enter a complete email address.",
    "phone.invalid_type": "Enter your phone number.",
    "phone.invalid_phone": "Enter a phone number with at least 7 digits.",
    "message.invalid_type": "Enter a plain-text message.",
    "message.too_long": "Keep your message to 500 characters or fewer.",
    "acknowledgesRequestNotReservation.acknowledgement_required": "Confirm that this is a request, not a reservation or guaranteed price.",
    "acknowledgesPrivacy.acknowledgement_required": "Confirm that we may use these details to review and reply.",
  };

  for (const form of document.querySelectorAll<HTMLFormElement>(".availability-form")) {
    const arrival = form.elements.namedItem("arrival") as HTMLInputElement | null;
    const departure = form.elements.namedItem("departure") as HTMLInputElement | null;
    const submit = form.querySelector<HTMLButtonElement>(".form-submit");
    const errorSummary = form.querySelector<HTMLElement>("[data-form-error-summary]");
    const errorList = errorSummary?.querySelector("ul");
    let started = false;
    let pending = false;

    if (!arrival || !departure || !submit || !errorSummary || !errorList) continue;

    const today = toLocalIsoDate(new Date());
    arrival.min = today;
    departure.min = today;

    form.addEventListener("input", () => {
      if (!started) {
        started = true;
        trackPublicEvent("form_start", "availability_form");
      }
      departure.min = arrival.value ? addDays(arrival.value, 1) : today;
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (pending) return;

      for (const field of form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[aria-invalid='true']")) {
        field.removeAttribute("aria-invalid");
      }
      for (const error of form.querySelectorAll<HTMLElement>("[data-field-error]")) {
        error.textContent = "";
      }
      errorList.replaceChildren();
      errorSummary.hidden = true;
      form.dataset.state = "idle";

      const data = new FormData(form);
      const validation = validateInquiry({
        arrival: data.get("arrival"),
        departure: data.get("departure"),
        guests: Number(data.get("guests")),
        pets: Number(data.get("pets")),
        name: data.get("name"),
        email: data.get("email"),
        phone: data.get("phone"),
        message: data.get("message"),
        acknowledgesRequestNotReservation: data.get("acknowledgesRequestNotReservation") === "true",
        acknowledgesPrivacy: data.get("acknowledgesPrivacy") === "true",
      });

      if (!validation.success) {
        form.dataset.state = "error";
        errorSummary.hidden = false;
        const seenFields = new Set<string>();

        for (const error of validation.errors) {
          if (seenFields.has(error.field)) continue;
          seenFields.add(error.field);
          const message = errorMessages[`${error.field}.${error.category}`] ?? "Review this field.";
          const field = form.elements.namedItem(error.field);
          const inlineError = form.querySelector<HTMLElement>(`[data-field-error="${error.field}"]`);
          if (field instanceof HTMLElement) field.setAttribute("aria-invalid", "true");
          if (inlineError) inlineError.textContent = message;

          const item = document.createElement("li");
          const link = document.createElement("a");
          const fieldId = field instanceof HTMLElement ? field.id : "";
          link.href = fieldId ? `#${fieldId}` : "#availability";
          link.textContent = message;
          item.append(link);
          errorList.append(item);
        }

        trackPublicEvent("form_validation_error", "availability_form");
        errorSummary.focus();
        return;
      }

      pending = true;
      form.dataset.state = "pending";
      form.setAttribute("aria-busy", "true");
      submit.disabled = true;
      trackPublicEvent("form_submit", "availability_form");
      form.submit();
    });
  }
</script>
