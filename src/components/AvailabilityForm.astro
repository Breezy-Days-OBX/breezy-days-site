---
import { property } from "../content/property";
import { siteContent } from "../content/site";
---

<form
  class="availability-form"
  name="availability-request"
  method="POST"
  action="/thanks"
  data-netlify="true"
  netlify-honeypot="company-website"
  aria-busy="false"
  data-state="idle"
>
  <input type="hidden" name="form-name" value="availability-request" />
  <p class="honeypot" hidden>
    <label
      >Leave this field empty <input
        name="company-website"
        tabindex="-1"
        autocomplete="off"
      /></label
    >
  </p>

  <div class="form-intro">
    <p class="eyebrow">Check your dates</p>
    <h2>Ask about your dates.</h2>
    <p>
      Michelle and Danny personally check the dates, your group details, and the current price
      before replying.
    </p>
  </div>

  <div class="form-error-summary" data-form-error-summary role="alert" tabindex="-1" hidden>
    <h3>Please check the highlighted details.</h3>
    <ul></ul>
  </div>

  <fieldset class="form-group form-group-stay">
    <legend>Your stay</legend>
    <div class="form-fields form-fields-stay">
      <div class="form-field">
        <label for="arrival">Arrival</label>
        <input
          id="arrival"
          name="arrival"
          type="date"
          aria-describedby="arrival-hint arrival-error"
          required
        />
        <span class="field-hint" id="arrival-hint"
          >Check-in is {property.arrival.checkIn.toLowerCase()}.</span
        >
        <span class="field-error" id="arrival-error" data-field-error="arrival" aria-live="polite"
        ></span>
      </div>

      <div class="form-field">
        <label for="departure">Departure</label>
        <input
          id="departure"
          name="departure"
          type="date"
          aria-describedby="departure-hint departure-error"
          required
        />
        <span class="field-hint" id="departure-hint"
          >Checkout is {property.arrival.checkout.toLowerCase()}.</span
        >
        <span
          class="field-error"
          id="departure-error"
          data-field-error="departure"
          aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="guests">Overnight guests</label>
        <input
          id="guests"
          name="guests"
          type="number"
          min="1"
          max={property.fit.maximumOvernightGuests}
          inputmode="numeric"
          aria-describedby="guests-hint guests-error"
          required
        />
        <span class="field-hint" id="guests-hint"
          >Up to {property.fit.maximumOvernightGuests} overnight guests.</span
        >
        <span class="field-error" id="guests-error" data-field-error="guests" aria-live="polite"
        ></span>
      </div>

      <div class="form-field">
        <label for="pets">Pets</label>
        <select
          id="pets"
          name="pets"
          aria-describedby="pets-hint pets-error"
          data-max-pets-select
          data-maximum-pets={property.pets.maximum}
          required
        >
          <option value="0">No pets</option>
          {
            Array.from({ length: property.pets.maximum }, (_, index) => index + 1).map((count) => (
              <option value={count}>
                {count} {count === 1 ? "pet" : "pets"}
              </option>
            ))
          }
        </select>
        <span class="field-hint" id="pets-hint" data-public-setting="petPolicyFormHint">
          Up to {property.pets.maximum} pets.
        </span>
        <span class="field-error" id="pets-error" data-field-error="pets" aria-live="polite"></span>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-group form-group-contact">
    <legend>How should the owners contact you?</legend>
    <div class="form-fields form-fields-contact">
      <div class="form-field">
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          minlength="2"
          maxlength="80"
          aria-describedby="name-error"
          required
        />
        <span class="field-error" id="name-error" data-field-error="name" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          maxlength="254"
          aria-describedby="email-error"
          required
        />
        <span class="field-error" id="email-error" data-field-error="email" aria-live="polite"
        ></span>
      </div>

      <div class="form-field">
        <label for="phone">Phone</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          minlength="7"
          maxlength="20"
          aria-describedby="phone-hint phone-error"
          required
        />
        <span class="field-hint" id="phone-hint"
          >Used only if the owner needs to clarify the request.</span
        >
        <span class="field-error" id="phone-error" data-field-error="phone" aria-live="polite"
        ></span>
      </div>

      <div class="form-field form-field-message">
        <label for="message">Anything else the owners should know? <span>(optional)</span></label>
        <textarea
          id="message"
          name="message"
          rows="4"
          maxlength="500"
          aria-describedby="message-hint message-error"></textarea>
        <span class="field-hint" id="message-hint"
          >Accessibility needs or a brief question are helpful here. Please do not include payment
          information.</span
        >
        <span class="field-error" id="message-error" data-field-error="message" aria-live="polite"
        ></span>
      </div>
    </div>
  </fieldset>

  <div class="form-confirmations">
    <div class="checkbox-field">
      <input
        id="acknowledges-request"
        name="acknowledgesRequestNotReservation"
        type="checkbox"
        value="true"
        aria-describedby="acknowledgesRequestNotReservation-error"
        required
      />
      <label for="acknowledges-request">
        I understand this request is not a reservation or a guaranteed price. The owner must confirm
        availability, total price, the agreement, and payment steps.
      </label>
      <span
        class="field-error"
        id="acknowledgesRequestNotReservation-error"
        data-field-error="acknowledgesRequestNotReservation"
        aria-live="polite"></span>
    </div>
    <div class="checkbox-field">
      <input
        id="acknowledges-privacy"
        name="acknowledgesPrivacy"
        type="checkbox"
        value="true"
        aria-describedby="acknowledgesPrivacy-error"
        required
      />
      <label for="acknowledges-privacy">
        I agree that Breezy Days may use these details to review and reply to this request, as
        described in the <a href="/privacy">privacy notice</a>.
      </label>
      <span
        class="field-error"
        id="acknowledgesPrivacy-error"
        data-field-error="acknowledgesPrivacy"
        aria-live="polite"></span>
    </div>
  </div>

  <div class="form-action">
    <button class="button form-submit" type="submit">
      <span data-submit-label>{siteContent.primaryAction.label}</span>
      <span class="form-pending-label" aria-hidden="true">Sending request…</span>
    </button>
    <p>No payment is collected here. Your request goes to the owners for a personal review.</p>
  </div>
</form>

<script>
  import { addDays, toLocalIsoDate } from "../lib/dateRules";
  import { trackPublicEvent } from "../lib/analytics";
  import {
    createAvailabilityFormController,
    type ErrorPresentation,
  } from "../lib/availabilityFormController";
  import { markAvailabilitySubmitted } from "../lib/submissionProvenance";

  for (const form of document.querySelectorAll<HTMLFormElement>(".availability-form")) {
    const arrival = form.elements.namedItem("arrival") as HTMLInputElement | null;
    const departure = form.elements.namedItem("departure") as HTMLInputElement | null;
    const pets = form.elements.namedItem("pets") as HTMLSelectElement | null;
    const submit = form.querySelector<HTMLButtonElement>(".form-submit");
    const errorSummary = form.querySelector<HTMLElement>("[data-form-error-summary]");
    const errorList = errorSummary?.querySelector("ul");

    if (!arrival || !departure || !pets || !submit || !errorSummary || !errorList) continue;

    const today = toLocalIsoDate(new Date());
    arrival.min = today;
    departure.min = today;

    const view = {
      enableCustomValidation() {
        form.noValidate = true;
      },
      readSubmission() {
        const data = new FormData(form);
        return {
          arrival: data.get("arrival"),
          departure: data.get("departure"),
          guests: Number(data.get("guests")),
          pets: Number(data.get("pets")),
          name: data.get("name"),
          email: data.get("email"),
          phone: data.get("phone"),
          message: data.get("message"),
          acknowledgesRequestNotReservation:
            data.get("acknowledgesRequestNotReservation") === "true",
          acknowledgesPrivacy: data.get("acknowledgesPrivacy") === "true",
        };
      },
      readMaximumPets() {
        return Number(pets.dataset.maximumPets);
      },
      resetValidation() {
        for (const field of form.querySelectorAll<HTMLElement>("[aria-invalid='true']")) {
          field.removeAttribute("aria-invalid");
        }
        for (const error of form.querySelectorAll<HTMLElement>("[data-field-error]")) {
          error.textContent = "";
        }
        errorList.replaceChildren();
        errorSummary.hidden = true;
        form.dataset.state = "idle";
      },
      fieldId(fieldName: string) {
        const field = form.elements.namedItem(fieldName);
        return field instanceof HTMLElement && field.id ? field.id : null;
      },
      showErrors(errors: readonly ErrorPresentation[]) {
        form.dataset.state = "error";
        errorSummary.hidden = false;
        for (const error of errors) {
          const field = form.elements.namedItem(error.field);
          const inlineError = form.querySelector<HTMLElement>(
            `[data-field-error="${error.field}"]`,
          );
          if (field instanceof HTMLElement) field.setAttribute("aria-invalid", "true");
          if (inlineError) inlineError.textContent = error.message;

          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = error.href;
          link.textContent = error.message;
          item.append(link);
          errorList.append(item);
        }
      },
      focusErrorSummary() {
        errorSummary.focus();
      },
      setPending() {
        form.dataset.state = "pending";
        form.setAttribute("aria-busy", "true");
        submit.disabled = true;
      },
      submitNative() {
        form.submit();
      },
    };

    const controller = createAvailabilityFormController(view, {
      today: () => toLocalIsoDate(new Date()),
      track: trackPublicEvent,
      markSubmitted: () => markAvailabilitySubmitted(window.sessionStorage),
    });

    form.addEventListener("input", () => {
      controller.start();
      departure.min = arrival.value ? addDays(arrival.value, 1) : today;
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      controller.submit();
    });

    controller.activate();
  }
</script>
