---
import { siteContent } from "../content/site";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="#hero" aria-label="Breezy Days OBX home">
      Breezy Days <span>OBX</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="#home">The Home</a>
      <a href="#reviews">Guest Reviews</a>
      <a href="#faq">FAQs</a>
    </nav>
    <a
      class="button button-small"
      href={siteContent.primaryAction.href}
      data-analytics-event="primary_request_click"
      data-analytics-category="header"
    >
      {siteContent.primaryAction.label}
    </a>
  </div>
</header>
