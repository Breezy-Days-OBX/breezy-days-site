---
import "../styles/global.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/dm-sans/800.css";
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/600.css";
import heroDeck from "../assets/images/hero-deck.jpeg";
import PublicTracking from "../components/PublicTracking.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  bodyClass?: string;
}

const { title, description, noindex = false, structuredData, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(heroDeck.src, Astro.site ?? Astro.url.origin);
const isOwnerRoute = Astro.url.pathname === "/owner" || Astro.url.pathname.startsWith("/owner/");
const ga4Id = import.meta.env.PUBLIC_GA4_ID?.trim();
const clarityId = import.meta.env.PUBLIC_CLARITY_ID?.trim();
const analyticsEnabled = !isOwnerRoute && Boolean(ga4Id || clarityId);
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173c32" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Breezy Days OBX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Ocean view from the deck at Breezy Days OBX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {
      !isOwnerRoute && (ga4Id || clarityId) && (
        <script
          is:inline
          defer
          src="/analytics.js"
          data-ga4-id={ga4Id}
          data-clarity-id={clarityId}
        />
      )
    }
  </head>
  <body class={bodyClass} data-analytics-enabled={analyticsEnabled ? "true" : "false"}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    {!isOwnerRoute && <PublicTracking />}
  </body>
</html>
