---
import { Image } from "astro:assets";

import AvailabilityForm from "../components/AvailabilityForm.astro";
import HeroAvailability from "../components/HeroAvailability.astro";
import HeroMarketplaceProof from "../components/HeroMarketplaceProof.astro";
import MarketplaceProof from "../components/MarketplaceProof.astro";
import PublicSettingsEnhancement from "../components/PublicSettingsEnhancement.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import aerialHome from "../assets/images/aerial-home.jpeg";
import bedroom from "../assets/images/bedroom.jpeg";
import heroDeck from "../assets/images/hero-deck.jpeg";
import kitchen from "../assets/images/kitchen.jpeg";
import livingDining from "../assets/images/living-dining.jpeg";
import privatePool from "../assets/images/private-pool.jpeg";
import { property } from "../content/property";
import { derivePublicPropertyFacts } from "../content/propertyPresentation";
import { siteContent } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMarketplaceProofPresentation } from "../lib/marketplaceProof.mjs";
import { ownerSettingsDefaults } from "../lib/ownerSettings";
import "../styles/home.css";

const proof = siteContent.marketplaceProof;
const approvedProof = getMarketplaceProofPresentation(proof);
const previewProof =
  import.meta.env.DEV && import.meta.env.PUBLIC_MARKETPLACE_PROOF_PREVIEW === "true";
const publishProof = approvedProof !== null || previewProof;
const publicFacts = derivePublicPropertyFacts(property);
const poolOpen = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(new Date(`2000-${ownerSettingsDefaults.poolOpenMonthDay}T00:00:00Z`));
const poolClose = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(new Date(`2000-${ownerSettingsDefaults.poolCloseMonthDay}T00:00:00Z`));
const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

const faqs = [
  {
    question: "Does this form reserve Breezy Days?",
    answer:
      property.booking.reservationStatus +
      ". The owners confirm availability, the full price, the agreement, and payment steps before a reservation is complete.",
  },
  {
    question: "How many people can stay?",
    answer: `Breezy Days sleeps up to ${property.fit.maximumOvernightGuests} overnight guests across ${property.sleeping.bedroomCount} bedrooms and ${property.sleeping.bedCount} beds. It is best suited to ${property.fit.bestFor.toLowerCase()}.`,
  },
  {
    question: "What should we know about stairs?",
    answer: property.access.entry + ". There is no stair-free route to the main entrance.",
  },
  {
    question: "Can we bring pets?",
    answer:
      "Pets may stay within the current pet limit and additional-cleaning fee shown in the rental information. The owners confirm both with the quote.",
  },
  {
    question: "Is the pool open all year?",
    answer: `The private pool is seasonal, and optional heat requires ${property.pool.heatNoticeHours} hours’ notice. The current season and fee are shown in the rental information and confirmed with the quote. The private hot tub is available ${property.hotTub.available}.`,
  },
  {
    question: "What should we pack for the beach?",
    answer: `${property.amenities.provided.includes("Beach chairs") ? "Beach chairs are provided." : ""} ${property.amenities.notProvided.join(", ")} are not provided. ${property.amenities.localRentalNote}.`,
  },
];
const ownerStorySentences = property.ownerStory
  .match(/[^.!?]+[.!?]+/g)
  ?.map((sentence) => sentence.trim()) ?? [property.ownerStory];
const ownerStoryLead = ownerStorySentences[0];
const ownerStoryRest = ownerStorySentences.slice(1).join(" ");
const businessPhoneHref = property.identity.businessPhone.replace(/\D/g, "");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "VacationRental",
  name: property.identity.publicName,
  description: property.fit.primaryPromise,
  image: new URL(heroDeck.src, Astro.site ?? Astro.url.origin).href,
  address: publicFacts.location,
  numberOfBedrooms: property.sleeping.bedroomCount,
  numberOfBathroomsTotal: property.bathrooms.full + property.bathrooms.half / 2,
  occupancy: {
    "@type": "QuantitativeValue",
    maxValue: property.fit.maximumOvernightGuests,
  },
  petsAllowed: publicFacts.petsAllowed,
  amenityFeature: [
    {
      "@type": "LocationFeatureSpecification",
      name: "Private pool",
      value: property.pool.private,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Private hot tub",
      value: property.hotTub.private,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Wi-Fi",
      value: property.amenities.provided.includes("Wi-Fi"),
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Full kitchen",
      value: property.amenities.provided.includes("Full kitchen"),
    },
  ],
};
---

<BaseLayout
  title={`${property.identity.publicName} | ${property.identity.propertyType} in the Outer Banks`}
  description={`${property.fit.primaryPromise}. Sleeps up to ${property.fit.maximumOvernightGuests} guests in ${property.identity.location}.`}
  structuredData={structuredData}
  bodyClass="home-page"
>
  <SiteHeader />

  <main id="main-content">
    <section class="hero" id="hero" aria-labelledby="hero-title">
      <div class="hero-media">
        <Image
          class="hero-image"
          src={heroDeck}
          alt="View from the Breezy Days deck toward neighboring Outer Banks homes"
          widths={[720, 1080, 1600, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={84}
          format="webp"
        />
        <div class="hero-wash" aria-hidden="true"></div>
      </div>
      <div class="shell hero-content">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-light">Rodanthe, North Carolina · Steps from the Atlantic</p>
          <h1 id="hero-title">Make room for the week everyone remembers.</h1>
          <p class="hero-lede">
            Stay together in Rodanthe, just a few steps from the beach and next door to the historic
            Rodanthe Pier.
          </p>
          {publishProof && <HeroMarketplaceProof proof={proof} preview={previewProof} />}
          {
            !publishProof && (
              <p class="hero-facts">
                {property.fit.maximumOvernightGuests} guests · {property.sleeping.bedroomCount}{" "}
                bedrooms · Private pool + hot tub
              </p>
            )
          }
        </div>
        <HeroAvailability maximumGuests={property.fit.maximumOvernightGuests} />
      </div>
    </section>

    <section class="section fit-section" id="fit" aria-labelledby="fit-title">
      <div class="shell">
        <div class="fit-heading">
          <div>
            <p class="eyebrow">01 · Know the fit</p>
            <h2 id="fit-title">Room for up to 10 guests to stay together.</h2>
          </div>
          <p>
            Breezy Days works especially well for {property.fit.bestFor.toLowerCase()}. The sleeping
            layout, amenities, and stair access are listed up front so you can decide before anyone
            packs.
          </p>
        </div>
        <div class="fit-strip" aria-label="Breezy Days at a glance">
          <div>
            <strong>{property.fit.maximumOvernightGuests}</strong><span>overnight guests</span>
          </div>
          <div>
            <strong>{property.sleeping.bedroomCount} bedrooms</strong><span
              >{property.sleeping.bedCount} beds</span
            >
          </div>
          <div class="fit-strip-pool">
            <strong>Private pool</strong><span>{property.hotTub.capacity}-person hot tub</span>
          </div>
          <div>
            <strong>Up to {property.pets.maximum} pets</strong><span>Confirmed with the quote</span>
          </div>
          <div class="fit-strip-access">
            <strong>Stair access</strong><span>A full flight is required</span>
          </div>
        </div>
        <p class="fit-footnote">
          {property.access.beach}. The home is next to the historic pier. <strong
            class="fit-footnote-highlight">Pier passes are included with the stay.</strong
          > The house is elevated on posts, and <strong class="fit-footnote-highlight"
            >a full flight of stairs is required to reach the front door.</strong
          >
        </p>
      </div>
    </section>

    <section class="section gallery-section" id="home" aria-labelledby="home-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">02 · Inside Breezy Days</p>
            <h2 id="home-title">Room to gather between beach days.</h2>
          </div>
          <p class="section-lede">
            Inside, an open living and dining area gives everyone space to eat, play games, and
            unwind together. Outside, the private pool is just downstairs.
          </p>
        </div>

        <div class="editorial-gallery">
          <figure class="gallery-photo gallery-living" data-gallery-feature="living">
            <Image
              src={livingDining}
              alt="Open living and dining space with windows and family seating at Breezy Days"
              widths={[640, 960, 1400]}
              sizes="(max-width: 760px) 100vw, 60vw"
              loading="lazy"
              quality={80}
              format="webp"
            />
            <figcaption>Open living and dining room</figcaption>
          </figure>
          <figure class="gallery-photo gallery-pool" data-gallery-feature="pool">
            <Image
              src={privatePool}
              alt="Private outdoor pool beside the elevated Breezy Days beach house"
              widths={[480, 760, 1000]}
              sizes="(max-width: 760px) 100vw, 38vw"
              loading="lazy"
              quality={80}
              format="webp"
            />
            <figcaption>Private outdoor pool</figcaption>
          </figure>
          <figure class="gallery-photo gallery-bedroom">
            <Image
              src={bedroom}
              alt="Prepared Breezy Days bedroom with fresh linens and coastal light"
              widths={[480, 760, 1000]}
              sizes="(max-width: 760px) 100vw, 38vw"
              loading="lazy"
              quality={80}
              format="webp"
            />
            <figcaption>One of four bedrooms</figcaption>
          </figure>
          <figure class="gallery-photo gallery-kitchen">
            <Image
              src={kitchen}
              alt="Bright full kitchen with island seating at Breezy Days"
              widths={[640, 960, 1400]}
              sizes="(max-width: 760px) 100vw, 60vw"
              loading="lazy"
              quality={80}
              format="webp"
            />
            <figcaption>Full kitchen with island seating</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section location-section" id="location" aria-labelledby="location-title">
      <div class="shell">
        <div class="location-story">
          <div class="location-photo">
            <Image
              src={aerialHome}
              alt="Aerial view of Breezy Days, its private pool, and the nearby Atlantic Ocean"
              widths={[576, 960]}
              sizes="(max-width: 820px) 100vw, 46vw"
              loading="lazy"
              quality={88}
              format="webp"
            />
            <span>{property.identity.location.split(", on ")[0]}</span>
          </div>
          <div class="location-copy">
            <p class="eyebrow">03 · Between ocean and sound</p>
            <h2 id="location-title">
              A few steps from the Atlantic, with Rodanthe Pier next door.
            </h2>
            <p>
              {publicFacts.location}. {property.access.beach}. The home is next to the historic
              pier, and <strong>pier passes are included with the stay.</strong>
            </p>
            <p>
              For privacy, the exact address and arrival instructions are shared only with confirmed
              guests.
            </p>
            <a
              class="text-link"
              href="#availability"
              data-analytics-event="primary_request_click"
              data-analytics-category="inline"
              >{siteContent.primaryAction.label}
              <span aria-hidden="true">→</span></a
            >
          </div>
        </div>
      </div>
    </section>

    <section class="section essentials-section" id="essentials" aria-labelledby="essentials-title">
      <div class="shell">
        <div class="stay-details-panel">
          <div class="section-heading essentials-heading">
            <p class="eyebrow eyebrow-light">04 · Sleeping setup and amenities</p>
            <h2 id="essentials-title">Know what’s here before you pack.</h2>
            <p>
              Breezy Days has {property.sleeping.bedroomCount} bedrooms, {property.bathrooms.full} full
              bathrooms and {property.bathrooms.half} half bathroom. Linens, bath towels, beach chairs,
              and other everyday supplies are listed below.
            </p>
            <a class="text-link text-link-light" href="/rental-information"
              >Read all rental information <span aria-hidden="true">→</span></a
            >
          </div>
          <div class="details-stack">
            <div class="sleeping-layout">
              <p class="detail-kicker">Sleeping layout</p>
              {
                property.sleeping.rooms.map((room, index) => (
                  <div class="sleep-row">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{room.name}</strong>
                    <small>
                      {room.beds
                        .map(
                          (bed) =>
                            `${bed.count} ${bed.size}${bed.size === "twin bunk" ? " beds" : " bed"}`,
                        )
                        .join(", ")}
                    </small>
                  </div>
                ))
              }
            </div>
            <div class="detail-pair">
              <div>
                <p class="detail-kicker">Provided</p>
                <p>{property.amenities.provided.join(" · ")}</p>
              </div>
              <div>
                <p class="detail-kicker">Bring or rent</p>
                <p>{property.amenities.notProvided.join(" · ")}</p>
                <small>{property.amenities.localRentalNote}.</small>
              </div>
            </div>
            <div class="season-note">
              <div>
                <p class="detail-kicker">Seasonal pool</p>
                <p>
                  <span data-public-setting="poolOpenMonthDay">{poolOpen}</span>–<span
                    data-public-setting="poolCloseMonthDay">{poolClose}</span
                  >
                </p>
              </div>
              <div>
                <p class="detail-kicker">Optional pool heat</p>
                <p data-public-setting="poolHeatFeeUsd">
                  {money.format(ownerSettingsDefaults.poolHeatFeeUsd)} per stay
                </p>
              </div>
              <div>
                <p class="detail-kicker">Pet policy</p>
                <p data-public-setting="petPolicySummary">
                  Up to {ownerSettingsDefaults.maxPets} pets · {
                    money.format(ownerSettingsDefaults.petFeeUsd)
                  } per stay
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class:list={[
        "section",
        "review-section",
        "tide-section",
        { "has-proof": approvedProof !== null },
      ]}
      id="reviews"
      aria-labelledby="reviews-title"
    >
      <h2 class="visually-hidden" id="reviews-title">Guest reviews and hosts</h2>
      <MarketplaceProof proof={proof} />
      <div class="shell owner-story">
        <p class="eyebrow">Meet your hosts</p>
        <div class="owner-story-copy">
          <p class="owner-story-lead">{ownerStoryLead}</p>
          {ownerStoryRest && <p class="owner-story-rest">{ownerStoryRest}</p>}
          <div class="owner-story-contact" aria-label="Contact Michelle and Danny Day">
            <a href={`mailto:${property.identity.email}`}>
              <span>Email</span>
              <strong>{property.identity.email}</strong>
            </a>
            <a href={`tel:${businessPhoneHref}`}>
              <span>Phone</span>
              <strong>{property.identity.businessPhone}</strong>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section process-section" id="process" aria-labelledby="process-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">05 · What happens next</p><h2 id="process-title">
              Send your dates. The owners confirm the details.
            </h2>
          </div>
          <p class="section-lede">
            {property.booking.reservationStatus}. Michelle and Danny confirm availability and the
            total price before you decide whether to book.
          </p>
        </div>
        <ol class="process-list">
          <li>
            <span>01</span><div>
              <h3>Tell the owners about your stay</h3><p>
                {property.booking.guestRequest}.
              </p>
            </div>
          </li>
          <li>
            <span>02</span><div>
              <h3>The owners confirm availability and pricing</h3><p>
                {property.booking.ownerReview}.
              </p>
            </div>
          </li>
          <li>
            <span>03</span><div>
              <h3>Review before you reserve</h3><p>
                {property.booking.confirmation}. Your request is not a reservation or a guaranteed
                price.
              </p>
            </div>
          </li>
        </ol>
        <div class="pricing-strip">
          <div>
            <span>Current rate guidance</span><strong data-public-setting="startingWeeklyRateUsd"
              >Personalized quote for your dates</strong
            >
          </div>
          <div>
            <span>Stay requirement</span><strong data-public-setting="minimumStayNights"
              >Stay requirements vary by dates</strong
            >
          </div>
          <p class="pricing-note" data-public-setting="pricingNote">
            {ownerSettingsDefaults.pricingNote}
          </p>
        </div>
      </div>
    </section>

    <section class="section availability" id="availability" aria-label="Check availability">
      <div class="shell">
        <AvailabilityForm />
      </div>
    </section>

    <section class="section faq-section" id="faq" aria-labelledby="faq-title">
      <div class="shell faq-layout">
        <div class="faq-heading">
          <p class="eyebrow">07 · Before you request</p>
          <h2 id="faq-title">Questions before you request dates.</h2>
          <p>
            Have a different question? Email <a href={`mailto:${property.identity.email}`}
              >{property.identity.email}</a
            >. Michelle and Danny will reply directly.
          </p>
        </div>
        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details open={index === 0}>
                <summary>
                  {faq.question}
                  <span aria-hidden="true">+</span>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section final-section" id="final-action" aria-labelledby="final-title">
      <div class="shell final-layout">
        <div>
          <p class="eyebrow eyebrow-light">Ready to check your dates?</p><h2 id="final-title">
            See whether your dates are open.
          </h2>
        </div>
        <div>
          <p>
            Send your dates and group details. Michelle and Danny will confirm availability, total
            price, and terms before you decide whether to book. Your request is not a reservation.
          </p>
          <a
            class="button button-light"
            href={siteContent.primaryAction.href}
            data-analytics-event="primary_request_click"
            data-analytics-category="final_action">{siteContent.primaryAction.label}</a
          >
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <PublicSettingsEnhancement />
</BaseLayout>
