---
import { Image } from "astro:assets";

import AvailabilityForm from "../components/AvailabilityForm.astro";
import PublicSettingsEnhancement from "../components/PublicSettingsEnhancement.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import aerialHome from "../assets/images/aerial-home.jpeg";
import bedroom from "../assets/images/bedroom.jpeg";
import heroDeck from "../assets/images/hero-deck.jpeg";
import kitchen from "../assets/images/kitchen.jpeg";
import livingDining from "../assets/images/living-dining.jpeg";
import privatePool from "../assets/images/private-pool.jpeg";
import { property } from "../content/property";
import { siteContent } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ownerSettingsDefaults } from "../lib/ownerSettings";

const proof = siteContent.marketplaceProof;
const poolOpen = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", timeZone: "UTC" })
  .format(new Date(`2000-${ownerSettingsDefaults.poolOpenMonthDay}T00:00:00Z`));
const poolClose = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", timeZone: "UTC" })
  .format(new Date(`2000-${ownerSettingsDefaults.poolCloseMonthDay}T00:00:00Z`));
const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

const faqs = [
  {
    question: "Does this form reserve Breezy Days?",
    answer: property.booking.reservationStatus + ". The owners confirm availability, the full price, the agreement, and payment steps before a reservation is complete.",
  },
  {
    question: "How many people can stay?",
    answer: `Breezy Days sleeps up to ${property.fit.maximumOvernightGuests} overnight guests across ${property.sleeping.bedroomCount} bedrooms and ${property.sleeping.bedCount} beds. It is best suited to ${property.fit.bestFor.toLowerCase()}.`,
  },
  {
    question: "What should we know about stairs?",
    answer: property.access.entry + ". There is no stair-free route to the main entrance.",
  },
  {
    question: "Can we bring pets?",
    answer: "Pets may stay within the current pet limit and additional-cleaning fee shown in the rental information. The owners confirm both with the quote.",
  },
  {
    question: "Is the pool open all year?",
    answer: `The private pool is seasonal, and optional heat requires ${property.pool.heatNoticeHours} hours’ notice. The current season and fee are shown in the rental information and confirmed with the quote. The private hot tub is available ${property.hotTub.available}.`,
  },
  {
    question: "What should we pack for the beach?",
    answer: `${property.amenities.provided.includes("Beach chairs") ? "Beach chairs are provided." : ""} ${property.amenities.notProvided.join(", ")} are not provided. ${property.amenities.localRentalNote}.`,
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "VacationRental",
  name: property.identity.publicName,
  description: property.fit.primaryPromise,
  image: new URL(heroDeck.src, Astro.site ?? Astro.url.origin).href,
  address: property.identity.location,
  numberOfBedrooms: property.sleeping.bedroomCount,
  numberOfBathroomsTotal: property.bathrooms.full + property.bathrooms.half / 2,
  occupancy: {
    "@type": "QuantitativeValue",
    maxValue: property.fit.maximumOvernightGuests,
  },
  petsAllowed: true,
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "Private pool", value: property.pool.private },
    { "@type": "LocationFeatureSpecification", name: "Private hot tub", value: property.hotTub.private },
    { "@type": "LocationFeatureSpecification", name: "Wi-Fi", value: property.amenities.provided.includes("Wi-Fi") },
    { "@type": "LocationFeatureSpecification", name: "Full kitchen", value: property.amenities.provided.includes("Full kitchen") },
  ],
};
---

<BaseLayout
  title={`${property.identity.publicName} | ${property.identity.propertyType} in the Outer Banks`}
  description={`${property.fit.primaryPromise}. Sleeps up to ${property.fit.maximumOvernightGuests} guests in ${property.identity.location}.`}
  structuredData={structuredData}
>
  <SiteHeader />

  <main id="main-content">
    <section class="hero" id="hero" aria-labelledby="hero-title">
      <Image
        class="hero-image"
        src={heroDeck}
        alt="View from the Breezy Days deck toward neighboring Outer Banks homes"
        widths={[720, 1080, 1600, 2200]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
        format="webp"
      />
      <div class="hero-wash" aria-hidden="true"></div>
      <div class="shell hero-content">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-light">{property.identity.location} · {property.identity.hostLine}</p>
          <h1 id="hero-title">Make room for the week everyone remembers.</h1>
          <p class="hero-lede">
            Ocean mornings, sound-side sunsets, and one easy home base for the whole family—just a few steps from the Atlantic.
          </p>
          <div class="hero-actions">
            <a
              class="button button-light"
              href={siteContent.primaryAction.href}
              data-analytics-event="primary_request_click"
              data-analytics-category="hero"
            >{siteContent.primaryAction.label}</a>
            <span>{property.fit.maximumOvernightGuests} guests · {property.sleeping.bedroomCount} bedrooms · Private pool + hot tub</span>
          </div>
          <div class="hero-proof" aria-label="Marketplace review summary">
            <div class="proof-ratings">
              <span><strong>{proof.airbnb.rating}</strong> Airbnb · {proof.airbnb.label}</span>
              <span><strong>{proof.vrbo.rating}</strong> Vrbo</span>
            </div>
            <blockquote>
              “{proof.quote.text}”
              <cite>{proof.quote.source}</cite>
            </blockquote>
          </div>
        </div>
        <a class="scroll-cue" href="#fit" aria-label="Continue to see whether Breezy Days fits your family">
          <span>Ocean to sound</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section class="availability" id="availability" aria-label="Check availability">
      <div class="shell">
        <AvailabilityForm />
      </div>
    </section>

    <section class="section section-intro tide-section" id="fit" aria-labelledby="fit-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">01 · Know the fit</p>
            <h2 id="fit-title">A family week, from ocean light to sound-side dusk.</h2>
          </div>
          <div class="section-lede">
            <p>{property.fit.bestFor}.</p>
            <p class="fit-callout">Sleeps up to {property.fit.maximumOvernightGuests} guests.</p>
          </div>
        </div>
        <div class="fit-ledger" aria-label="At a glance">
          <div><strong>{property.sleeping.bedroomCount}</strong><span>bedrooms</span></div>
          <div><strong>{property.sleeping.bedCount}</strong><span>beds</span></div>
          <div><strong>{property.bathrooms.full} + {property.bathrooms.half}</strong><span>full + half baths</span></div>
          <div><strong>{property.access.parkingVehicles}</strong><span>vehicles</span></div>
        </div>
        <div class="fit-notes">
          <article>
            <span>Atlantic side</span>
            <h3>Beach access a few steps away</h3>
            <p>{property.access.beach}. {property.access.pier}</p>
          </article>
          <article>
            <span>At the house</span>
            <h3>Private water, two ways</h3>
            <p>A seasonal private pool and a {property.hotTub.capacity}-person private hot tub available {property.hotTub.available}.</p>
          </article>
          <article>
            <span>Important access note</span>
            <h3>A full flight to the front door</h3>
            <p>{property.access.entry}.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section gallery-section" id="home" aria-labelledby="home-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">02 · Picture the week</p>
            <h2 id="home-title">The spaces between beach days matter, too.</h2>
          </div>
          <p class="section-lede">Coffee by the windows. Dinner around one table. A last swim while the light changes. This is the house at the heart of the trip.</p>
        </div>

        <div class="photo-grid">
          <figure class="photo photo-large">
            <Image src={livingDining} alt="Open living and dining space with windows and family seating at Breezy Days" widths={[640, 960, 1400]} sizes="(max-width: 760px) 100vw, 60vw" loading="lazy" quality={80} format="webp" />
            <figcaption>Gather · The living and dining room</figcaption>
          </figure>
          <figure class="photo">
            <Image src={privatePool} alt="Private outdoor pool beside the elevated Breezy Days beach house" widths={[480, 760, 1000]} sizes="(max-width: 760px) 100vw, 38vw" loading="lazy" quality={80} format="webp" />
            <figcaption>Cool off · The private pool</figcaption>
          </figure>
          <figure class="photo">
            <Image src={bedroom} alt="Prepared Breezy Days bedroom with fresh linens and coastal light" widths={[480, 760, 1000]} sizes="(max-width: 760px) 100vw, 38vw" loading="lazy" quality={80} format="webp" />
            <figcaption>Reset · A quiet bedroom</figcaption>
          </figure>
          <figure class="photo photo-wide">
            <Image src={kitchen} alt="Bright full kitchen with island seating at Breezy Days" widths={[640, 960, 1400]} sizes="(max-width: 760px) 100vw, 60vw" loading="lazy" quality={80} format="webp" />
            <figcaption>Share · The full kitchen</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section essentials-section" id="essentials" aria-labelledby="essentials-title">
      <div class="shell essentials-layout">
        <div class="section-heading essentials-heading">
          <p class="eyebrow eyebrow-light">03 · Sleep, settle in, pack well</p>
          <h2 id="essentials-title">The practical details, made plain.</h2>
          <p>{property.sleeping.bedroomCount} bedrooms, {property.bathrooms.full} full bathrooms and {property.bathrooms.half} half bathroom, with the everyday supplies that make arrival easier.</p>
          <a class="text-link text-link-light" href="/rental-information">Read all rental information <span aria-hidden="true">→</span></a>
        </div>
        <div class="details-stack">
          <div class="sleeping-layout">
            <p class="detail-kicker">Sleeping layout</p>
            {property.sleeping.rooms.map((room, index) => (
              <div class="sleep-row">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{room.name}</strong>
                <small>{room.beds.map((bed) => `${bed.count} ${bed.size}${bed.size === "twin bunk" ? " beds" : " bed"}`).join(", ")}</small>
              </div>
            ))}
          </div>
          <div class="detail-pair">
            <div>
              <p class="detail-kicker">Provided</p>
              <p>{property.amenities.provided.join(" · ")}</p>
            </div>
            <div>
              <p class="detail-kicker">Bring or rent</p>
              <p>{property.amenities.notProvided.join(" · ")}</p>
              <small>{property.amenities.localRentalNote}.</small>
            </div>
          </div>
          <div class="season-note">
            <div>
              <p class="detail-kicker">Seasonal pool</p>
              <p><span data-public-setting="poolOpenMonthDay">{poolOpen}</span>–<span data-public-setting="poolCloseMonthDay">{poolClose}</span></p>
            </div>
            <div>
              <p class="detail-kicker">Optional pool heat</p>
              <p data-public-setting="poolHeatFeeUsd">{money.format(ownerSettingsDefaults.poolHeatFeeUsd)} per stay</p>
            </div>
            <div>
              <p class="detail-kicker">Pet cleaning fee</p>
              <p><span data-public-setting="petFeeUsd">{money.format(ownerSettingsDefaults.petFeeUsd)} per stay</span> · Up to <span data-public-setting="maxPets">{ownerSettingsDefaults.maxPets}</span> pets</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section review-section tide-section" id="reviews" aria-labelledby="reviews-title" data-launch-reverification={proof.requiresLaunchReverification ? "required" : "complete"}>
      <div class="shell review-layout">
        <div class="review-quote-wrap">
          <p class="eyebrow">04 · Guest perspective</p>
          <h2 class="visually-hidden" id="reviews-title">Guest reviews and owner story</h2>
          <blockquote>“{proof.quote.text}”</blockquote>
          <p class="quote-source">{proof.quote.source}</p>
        </div>
        <aside class="rating-panel" aria-label="Marketplace rating snapshot">
          <p class="rating-label">Marketplace snapshot</p>
          <div class="rating-row"><strong>{proof.airbnb.rating}</strong><span>Airbnb<br />{proof.airbnb.reviewCount} reviews</span></div>
          <div class="rating-row"><strong>{proof.vrbo.rating.replace("/10", "")}</strong><span>Vrbo<br />{proof.vrbo.reviewCount} reviews</span></div>
          <p class="rating-note">Checked {proof.checkedOnDisplay}; this centralized proof remains subject to the launch reverification gate.</p>
        </aside>
      </div>
      <div class="shell owner-story">
        <p class="eyebrow">Why this home</p>
        <blockquote>{property.ownerStory}</blockquote>
        <p>{property.identity.hostLine}</p>
      </div>
    </section>

    <section class="section process-section" id="process" aria-labelledby="process-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">05 · What happens next</p><h2 id="process-title">A direct request, then a human answer.</h2></div>
          <p class="section-lede">{property.booking.reservationStatus}. The owner confirms availability and price before you decide whether to complete the booking.</p>
        </div>
        <ol class="process-list">
          <li><span>01</span><div><h3>Share dates and party details</h3><p>{property.booking.guestRequest}.</p></div></li>
          <li><span>02</span><div><h3>The owners check the whole picture</h3><p>{property.booking.ownerReview}.</p></div></li>
          <li><span>03</span><div><h3>Review before you reserve</h3><p>{property.booking.confirmation}. Your request is not a reservation or a guaranteed price.</p></div></li>
        </ol>
        <div class="pricing-strip">
          <div><span>Current rate guidance</span><strong data-public-setting="startingWeeklyRateUsd">Personalized quote for your dates</strong></div>
          <div><span>Stay requirement</span><strong data-public-setting="minimumStayNights">Stay requirements vary by dates</strong></div>
          <p class="pricing-note" data-public-setting="pricingNote">{ownerSettingsDefaults.pricingNote}</p>
        </div>
      </div>
    </section>

    <section class="section location-section" id="location" aria-labelledby="location-title">
      <div class="shell location-layout">
        <div class="location-photo">
          <Image src={aerialHome} alt="Aerial view of Breezy Days, its private pool, and the nearby Atlantic Ocean" widths={[576, 960]} sizes="(max-width: 820px) 100vw, 50vw" loading="lazy" quality={88} format="webp" />
          <span>{property.identity.location.split(", on ")[0]}</span>
        </div>
        <div class="location-copy">
          <p class="eyebrow">06 · Between ocean and sound</p>
          <h2 id="location-title">Close enough to hear the Atlantic. Private enough to arrive calmly.</h2>
          <p>{property.identity.location}. {property.access.beach}. The home is next to the historic pier, with pier passes included.</p>
          <p>For privacy, the exact address and arrival instructions are shared only with confirmed guests.</p>
          <a class="text-link" href="#availability" data-analytics-event="primary_request_click" data-analytics-category="inline">{siteContent.primaryAction.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq" aria-labelledby="faq-title">
      <div class="shell faq-layout">
        <div class="faq-heading">
          <p class="eyebrow">07 · Before you request</p>
          <h2 id="faq-title">Clear answers before you share a thing.</h2>
          <p>Have a different question? Email <a href={`mailto:${property.identity.email}`}>{property.identity.email}</a>. Contact stays secondary to the availability request.</p>
        </div>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section final-section" id="final-action" aria-labelledby="final-title">
      <div class="shell final-layout">
        <div><p class="eyebrow eyebrow-light">One family week · One clear next step</p><h2 id="final-title">See whether your dates are open.</h2></div>
        <div>
          <p>Share the basics. The owners confirm fit, availability, total price, and terms. It is not a reservation or guaranteed price.</p>
          <a class="button button-light" href={siteContent.primaryAction.href} data-analytics-event="primary_request_click" data-analytics-category="final_action">{siteContent.primaryAction.label}</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <a class="mobile-booking-bar" href="#availability" data-analytics-event="primary_request_click" data-analytics-category="mobile_action">{siteContent.primaryAction.label}</a>
  <PublicSettingsEnhancement />
</BaseLayout>
