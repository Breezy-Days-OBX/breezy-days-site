---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Request received | Breezy Days OBX"
  description="Your Breezy Days availability request has been received."
>
  <main class="thanks-page" id="main-content">
    <div class="thanks-card">
      <p class="eyebrow">Request received</p>
      <h1>Thanks for sharing your dates.</h1>
      <p>
        The owner will review availability, price, and stay details before anything is reserved.
      </p>
      <a class="button" href="/">Back to Breezy Days</a>
    </div>
  </main>
</BaseLayout>

