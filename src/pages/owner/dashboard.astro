---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ownerSettingDefinitions } from "../../lib/ownerSettings";

const settingsEntries = Object.entries(ownerSettingDefinitions);
const displayFallback = (value: unknown) => value === null ? "Not currently published" : String(value);
---

<BaseLayout
  title="Owner dashboard | Breezy Days OBX"
  description="Private owner settings for Breezy Days OBX."
  noindex
>
  <main class="owner-dashboard" id="main-content">
    <header class="owner-dashboard-header">
      <div>
        <a class="wordmark" href="/">Breezy Days <span>OBX</span></a>
        <p class="eyebrow">Owner dashboard</p>
        <h1>Published stay details.</h1>
      </div>
      <button class="owner-logout" type="button" data-owner-logout>Log out</button>
    </header>

    <div class="owner-status" data-dashboard-status data-kind="neutral" role="status" aria-live="polite">
      Loading current settings…
    </div>

    <div class="owner-dashboard-grid" data-dashboard-content hidden>
      <section class="owner-settings-panel" aria-labelledby="settings-title">
        <div class="owner-panel-heading">
          <div>
            <p class="eyebrow">Live public values</p>
            <h2 id="settings-title">Settings</h2>
          </div>
          <p>Last saved <time data-last-saved>—</time></p>
        </div>

        <form data-owner-settings-form novalidate>
          <div class="owner-error-summary" data-owner-error-summary hidden tabindex="-1">
            <strong>Review the highlighted settings.</strong>
          </div>

          <div class="owner-settings-list">
            {settingsEntries.map(([key, definition]) => (
              <section class="owner-setting-row" data-owner-setting-field>
                <div class="owner-setting-copy">
                  <label for={`owner-setting-${key}`}>{definition.name}</label>
                  <p>{definition.purpose}</p>
                  <dl>
                    <div><dt>Allowed</dt><dd>{definition.allowed}</dd></div>
                    <div><dt>Public location</dt><dd>{definition.publicDestination}</dd></div>
                    <div><dt>Fallback</dt><dd>{displayFallback(definition.fallback)}</dd></div>
                  </dl>
                </div>
                <div class="owner-setting-control">
                  {definition.type === "plain text" ? (
                    <textarea
                      id={`owner-setting-${key}`}
                      name={key}
                      maxlength="160"
                      rows="3"
                      aria-describedby={`owner-help-${key} owner-error-${key}`}
                      required
                    >{String(definition.fallback)}</textarea>
                  ) : (
                    <input
                      id={`owner-setting-${key}`}
                      name={key}
                      type={definition.type === "month-day" ? "text" : "number"}
                      inputmode={definition.type === "month-day" ? "numeric" : "decimal"}
                      pattern={definition.type === "month-day" ? "[0-9]{2}-[0-9]{2}" : undefined}
                      step={definition.type.includes("integer") ? "1" : undefined}
                      value={definition.fallback ?? ""}
                      aria-describedby={`owner-help-${key} owner-error-${key}`}
                      required={!definition.type.startsWith("nullable")}
                    />
                  )}
                  <small id={`owner-help-${key}`} class="owner-field-help">{definition.ownerHelpText}</small>
                  <small id={`owner-error-${key}`} class="owner-field-error" data-field-error={key}></small>
                </div>
              </section>
            ))}
          </div>

          <div class="owner-save-bar">
            <p>Saving publishes the complete validated settings object; partial changes are never sent.</p>
            <button class="button" type="submit" data-owner-save>Save all settings</button>
          </div>
        </form>
      </section>

      <aside class="owner-history-panel" aria-labelledby="history-title">
        <p class="eyebrow">Recovery points</p>
        <h2 id="history-title">Saved versions</h2>
        <p>Only save time and restore controls are shown. Saved field contents remain private until restored.</p>
        <div data-snapshot-empty>No earlier versions are available yet.</div>
        <ol class="owner-snapshot-list" data-snapshot-list></ol>
      </aside>
    </div>

    <noscript>
      <p class="owner-noscript">JavaScript is required to use the owner dashboard.</p>
    </noscript>
  </main>

  <script>
    import { getUser, logout } from "@netlify/identity";
    import {
      fetchOwnerSettings,
      fetchOwnerSnapshots,
      restoreOwnerSettings,
      saveOwnerSettings,
      type OwnerSnapshot,
    } from "../../lib/owner/ownerApi";
    import { runOwnerRestore, runOwnerSave } from "../../lib/owner/ownerDashboard";
    import { OWNER_EDITABLE_KEYS, serializeOwnerSettings } from "../../lib/owner/ownerForm";
    import type { OwnerSettings } from "../../lib/ownerSettings";

    const content = document.querySelector<HTMLElement>("[data-dashboard-content]");
    const form = document.querySelector<HTMLFormElement>("[data-owner-settings-form]");
    const status = document.querySelector<HTMLElement>("[data-dashboard-status]");
    const lastSaved = document.querySelector<HTMLTimeElement>("[data-last-saved]");
    const snapshotList = document.querySelector<HTMLOListElement>("[data-snapshot-list]");
    const snapshotEmpty = document.querySelector<HTMLElement>("[data-snapshot-empty]");
    const errorSummary = document.querySelector<HTMLElement>("[data-owner-error-summary]");
    const saveButton = document.querySelector<HTMLButtonElement>("[data-owner-save]");
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-owner-logout]");
    let currentSettings: OwnerSettings | null = null;
    let currentAction: "save" | "restore" = "save";

    const messages: Record<string, string> = {
      loading: "Loading current settings…",
      saving: "Saving all settings…",
      restoring: "Restoring the selected saved version…",
      success: "Settings saved and live values refreshed.",
      validation: "Some settings need attention before they can be saved.",
      conflict: "The settings changed in another session. Reload this page to review the latest values.",
      auth: "Your owner session has expired. Return to owner access and sign in again.",
      forbidden: "This account does not have permission to manage owner settings.",
      method: "That owner action is not currently available.",
      service: "The owner settings service is temporarily unavailable. Try again shortly.",
    };

    const setBusy = (busy: boolean) => {
      saveButton?.toggleAttribute("disabled", busy);
      logoutButton?.toggleAttribute("disabled", busy);
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-restore-key]")) {
        button.toggleAttribute("disabled", busy);
      }
    };

    const transition = (state: string) => {
      if (status) {
        status.textContent = state === "success" && currentAction === "restore"
          ? "Saved version restored and live values refreshed."
          : messages[state] ?? messages.service;
        status.dataset.kind = state === "success" ? "success" : ["saving", "restoring", "loading"].includes(state) ? "neutral" : "error";
      }
      setBusy(state === "saving" || state === "restoring");
    };

    const formatDate = (value: string) => new Intl.DateTimeFormat(undefined, {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(value));

    const clearFieldErrors = () => {
      if (errorSummary) errorSummary.hidden = true;
      for (const field of OWNER_EDITABLE_KEYS) {
        const input = form?.elements.namedItem(field);
        if (input instanceof HTMLElement) input.removeAttribute("aria-invalid");
        const error = document.querySelector<HTMLElement>(`[data-field-error="${field}"]`);
        if (error) error.textContent = "";
      }
    };

    const showFieldErrors = (fieldErrors: Record<string, string>) => {
      clearFieldErrors();
      if (errorSummary) {
        errorSummary.hidden = false;
        errorSummary.focus();
      }
      for (const [field, message] of Object.entries(fieldErrors)) {
        const input = form?.elements.namedItem(field);
        if (input instanceof HTMLElement) input.setAttribute("aria-invalid", "true");
        const error = document.querySelector<HTMLElement>(`[data-field-error="${field}"]`);
        if (error) error.textContent = message;
      }
    };

    const applySettings = (settings: OwnerSettings) => {
      currentSettings = settings;
      for (const field of OWNER_EDITABLE_KEYS) {
        const input = form?.elements.namedItem(field);
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
          input.value = settings[field] === null ? "" : String(settings[field]);
        }
      }
      if (lastSaved) {
        lastSaved.dateTime = settings.updatedAt;
        lastSaved.textContent = formatDate(settings.updatedAt);
      }
    };

    const renderSnapshots = (snapshots: OwnerSnapshot[]) => {
      if (!snapshotList || !snapshotEmpty) return;
      snapshotList.replaceChildren();
      snapshotEmpty.hidden = snapshots.length > 0;
      for (const snapshot of snapshots) {
        const item = document.createElement("li");
        const time = document.createElement("time");
        time.dateTime = snapshot.createdAt;
        time.textContent = formatDate(snapshot.createdAt);
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.restoreKey = snapshot.key;
        button.textContent = "Restore";
        button.addEventListener("click", () => void restoreSnapshot(snapshot));
        item.append(time, button);
        snapshotList.append(item);
      }
    };

    const refreshDashboard = async () => {
      const [settings, snapshotResponse] = await Promise.all([
        fetchOwnerSettings(),
        fetchOwnerSnapshots(),
      ]);
      applySettings(settings);
      renderSnapshots(snapshotResponse.snapshots);
      return { settings, snapshots: snapshotResponse.snapshots };
    };

    const restoreSnapshot = async (snapshot: OwnerSnapshot) => {
      currentAction = "restore";
      const result = await runOwnerRestore({
        key: snapshot.key,
        confirm: () => window.confirm(`Restore the version saved ${formatDate(snapshot.createdAt)}? Current settings will be saved as a recovery point first.`),
        restore: restoreOwnerSettings,
        refresh: refreshDashboard,
        transition,
      });
      if (result.state === "cancelled") return;
      setBusy(false);
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!currentSettings) return;
      clearFieldErrors();
      currentAction = "save";
      const result = await runOwnerSave({
        serialize: () => serializeOwnerSettings(new FormData(form).entries(), currentSettings!.updatedAt),
        save: saveOwnerSettings,
        refresh: refreshDashboard,
        transition,
      });
      if (result.state === "validation" && "fieldErrors" in result) showFieldErrors(result.fieldErrors ?? {});
      setBusy(false);
    });

    logoutButton?.addEventListener("click", async () => {
      setBusy(true);
      try {
        await logout();
        window.location.replace("/owner");
      } catch {
        transition("service");
        setBusy(false);
      }
    });

    try {
      const user = await getUser();
      if (!user) {
        window.location.replace("/owner");
      } else {
        await refreshDashboard();
        if (content) content.hidden = false;
        if (status) status.textContent = "Current settings loaded.";
      }
    } catch (error) {
      transition(typeof error === "object" && error !== null && "kind" in error ? String(error.kind) : "service");
    }
  </script>
</BaseLayout>
